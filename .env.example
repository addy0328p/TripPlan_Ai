# Required application services
DATABASE_URL=postgresql://tripmate_user:change-me@localhost:5432/travel_db
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# Optional model overrides for image understanding and speech transcription
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Used when the traveler does not provide a departure airport
DEFAULT_ORIGIN_IATA=DEL
